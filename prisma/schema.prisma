generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  taxId         String?
  fiscalAddress String?
  contactName   String?
  contactRole   String?
  contactPhone  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  estimates Estimate[] // <— relación inversa
}

model Estimate {
  id     Int @id @default(autoincrement())
  number Int
  year   Int

  clientId String @db.Uuid // <— antes era Int
  client   Client @relation(fields: [clientId], references: [id])

  date         DateTime       @default(now())
  currency     String         @default("USD")
  exchangeRate Decimal?       @db.Decimal(18, 6)
  items        EstimateItem[]
  notes        String?
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  discountRate Decimal        @default(0) @db.Decimal(5, 2)
  subtotal     Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal        @default(0) @db.Decimal(18, 2)
  discountAmt  Decimal        @default(0) @db.Decimal(18, 2)
  total        Decimal        @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimateItem {
  id          Int      @id @default(autoincrement())
  estimateId  Int
  estimate    Estimate @relation(fields: [estimateId], references: [id])
  idx         Int
  description String
  qty         Decimal  @db.Decimal(18, 4)
  unit        String?
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
}
